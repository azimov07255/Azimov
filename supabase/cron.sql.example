-- Schedule the reminder job every 10 minutes (needs the pg_cron and pg_net extensions).
-- Replace <PROJECT_REF>. The shared secret is read from public.azimov_private, so nothing sensitive appears here.
select cron.schedule(
  'azimov-notify',
  '*/10 * * * *',
  $$ select net.http_post(
       url     := 'https://<PROJECT_REF>.supabase.co/functions/v1/azimov-notify',
       headers := jsonb_build_object('Content-Type', 'application/json',
                                     'x-cron-secret', (select value from public.azimov_private where key = 'cron_secret')),
       body    := '{}'::jsonb,
       timeout_milliseconds := 20000
     ) $$
);
